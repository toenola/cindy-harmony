{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:mobile_splash_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {"actions": ["ohos.want.action.sendData"], "uris": [{"scheme": "file", "utd": "general.text", "maxFileSupported": 20}, {"scheme": "file", "utd": "general.hyperlink", "maxFileSupported": 20}, {"scheme": "file", "utd": "general.image", "maxFileSupported": 20}, {"scheme": "file", "utd": "general.file", "maxFileSupported": 20}]},
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "cindy",
                "host": "session"
              },
              { "scheme": "cindy", "host": "relay" },
              { "scheme": "cindycn", "host": "relay" },
              { "scheme": "cindydev", "host": "relay" },
              { "scheme": "cindy", "host": "chat-invite" },
              { "scheme": "cindycn", "host": "chat-invite" },
              { "scheme": "cindydev", "host": "chat-invite" },
              { "scheme": "cindy", "host": "shared-task" },
              { "scheme": "cindycn", "host": "shared-task" },
              { "scheme": "cindydev", "host": "shared-task" },
              { "scheme": "cindy", "host": "shared-session" },
              { "scheme": "cindycn", "host": "shared-session" },
              { "scheme": "cindydev", "host": "shared-session" }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "UsageFormExtensionAbility",
        "srcEntry": "./ets/usageformextension/UsageFormExtensionAbility.ets",
        "type": "form",
        "exported": true,
        "metadata": [{ "name": "ohos.extension.form", "resource": "$profile:usage_form_config" }]
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      },
      {
        "name": "TaskPushExtensionAbility",
        "srcEntry": "./ets/pushextensionability/TaskPushExtensionAbility.ets",
        "type": "push",
        "exported": false
      }
    ]
  }
}
